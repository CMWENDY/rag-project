# Copy this file to `.env` and fill in real values.
# `.env` is gitignored, so real secrets never get committed.

# Your real OpenAI API key (from the OpenAI dashboard).
OPENAI_API_KEY=sk-your-openai-key-here

# The secret that gates the /v1/ingest endpoint. Any long random string you choose.
DEMO_KEY=choose-any-long-random-string
